rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'manikantejaswarooparni@gmail.com' ||
        request.auth.token.email.lower() == 'manikantatejaswarooparni@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['learner', 'developer'] &&
             data.subscriptionStatus in ['free', 'premium'];
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == userId &&
                       (incoming().role == 'learner' || isAdmin());
                       
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          isValidUser(incoming()) &&
          incoming().uid == existing().uid &&
          // Ordinary users cannot elevate role or subscription without admin
          incoming().role == existing().role &&
          incoming().subscriptionStatus == existing().subscriptionStatus
        )
      );
      
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Waitlist Collection
    match /waitlist/{waitlistId} {
      allow create: if incoming().email is string && incoming().email.size() <= 255;
      allow read, update, delete: if isAdmin();
    }

    // System Capacity Singleton
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
